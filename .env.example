# ---------- App ----------
APP_ENV=development                       # development | staging | production
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_HOURS=720
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://remarka:remarka@localhost:5432/remarka

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=                  # X-Telegram-Bot-Api-Secret-Token value
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# ---------- Books ----------
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# ---------- AI ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
AI_PROVIDER=openai                        # openai | fake  (fake = deterministic local stub)
AI_TOP_K=8
AI_MIN_RELEVANCE=0.15                     # cosine floor; tune per embedding model
AI_MAX_QUESTION_LENGTH=1000

# ---------- Limits ----------
FREE_AI_REQUESTS_PER_MONTH=10
PREMIUM_AI_REQUESTS_PER_MONTH=500

# ---------- Storage ----------
STORAGE_BACKEND=local                     # local | s3 (s3 not implemented yet)
STORAGE_LOCAL_DIR=/data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/uploads
UPLOAD_MAX_BYTES=5242880

# ---------- Billing / feature flags ----------
TELEGRAM_PREMIUM_PRICE_STARS=250
PREMIUM_PERIOD_DAYS=30
ENABLE_TELEGRAM_STARS=true
ENABLE_YOOKASSA=false
ENABLE_PLATEGA=false
ENABLE_CRYPTOBOT=false

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

PLATEGA_API_KEY=
PLATEGA_MERCHANT_ID=

CRYPTOBOT_TOKEN=

# ---------- Rate limiting ----------
RATE_LIMIT_BACKEND=memory                 # memory | redis (redis not implemented yet)
REDIS_URL=
